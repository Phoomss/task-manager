# Local .terraform path
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (often contain sensitive data/secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files
.terraform.tfstate.lock.info

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Ignore private keys and other key files
*.pem

# Ignore OS files
.DS_Store