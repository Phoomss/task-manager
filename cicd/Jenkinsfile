pipeline {
    agent any

    triggers {
        // Trigger on Git push to main or develop branch
        // In actual Jenkins, this is configured via Webhook, but we define the branch filter here
        refTrigger('refs/heads/main, refs/heads/develop')
    }

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        DOCKER_REPO_BACKEND = 'task-manager-backend'
        DOCKER_REPO_FRONTEND = 'task-manager-frontend'
        KUBERNETES_CREDENTIALS_ID = 'kubeconfig-credentials'
        SLACK_CHANNEL = '#ci-cd-alerts'
        IMAGE_TAG = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Type Check') {
            parallel {
                stage('Backend Lint') {
                    steps {
                        dir('backend') {
                            sh 'npm ci'
                            sh 'npm run lint'
                        }
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                            sh 'npm run lint'
                        }
                    }
                }
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        dir('backend') {
                            sh 'npm run test'
                        }
                    }
                }
                stage('Frontend Tests') {
                    steps {
                        dir('frontend') {
                            // Run frontend tests (assuming test script is configured)
                            sh 'npm run test'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    echo "Building Docker Images for Tag: ${IMAGE_TAG}"
                    sh "docker build -t ${DOCKER_REGISTRY}/${DOCKER_REPO_BACKEND}:${IMAGE_TAG} -t ${DOCKER_REGISTRY}/${DOCKER_REPO_BACKEND}:latest ./backend"
                    sh "docker build -t ${DOCKER_REGISTRY}/${DOCKER_REPO_FRONTEND}:${IMAGE_TAG} -t ${DOCKER_REGISTRY}/${DOCKER_REPO_FRONTEND}:latest ./frontend"
                }
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin ${DOCKER_REGISTRY}"
                        sh "docker push ${DOCKER_REGISTRY}/${DOCKER_REPO_BACKEND}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_REGISTRY}/${DOCKER_REPO_BACKEND}:latest"
                        sh "docker push ${DOCKER_REGISTRY}/${DOCKER_REPO_FRONTEND}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_REGISTRY}/${DOCKER_REPO_FRONTEND}:latest"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    withKubeConfig([credentialsId: KUBERNETES_CREDENTIALS_ID]) {
                        echo "Deploying to Kubernetes Cluster"
                        
                        // Update deployment manifests with the newly built Docker image tag
                        sh "sed -i 's|image: .*backend:.*|image: ${DOCKER_REGISTRY}/${DOCKER_REPO_BACKEND}:${IMAGE_TAG}|g' infrastructure/k8s/02-backend-deployment.yaml"
                        sh "sed -i 's|image: .*frontend:.*|image: ${DOCKER_REGISTRY}/${DOCKER_REPO_FRONTEND}:${IMAGE_TAG}|g' infrastructure/k8s/01-frontend-deployment.yaml"
                        
                        // Apply namespaces, configs, deployments, and services
                        sh "kubectl apply -f infrastructure/k8s/00-namespace.yaml"
                        sh "kubectl apply -f infrastructure/k8s/03-postgres-deployment.yaml"
                        sh "kubectl apply -f infrastructure/k8s/02-backend-deployment.yaml"
                        sh "kubectl apply -f infrastructure/k8s/01-frontend-deployment.yaml"
                        sh "kubectl apply -f infrastructure/k8s/04-ingress.yaml"
                        
                        // Wait for rollout completion
                        sh "kubectl rollout status deployment/task-manager-backend -n task-manager --timeout=150s"
                        sh "kubectl rollout status deployment/task-manager-frontend -n task-manager --timeout=150s"
                    }
                }
            }
        }

        stage('Run Load Tests (k6)') {
            steps {
                dir('load-tests') {
                    // Execute the k6 load test script
                    sh "k6 run task-api-test.js"
                }
            }
        }
    }

    post {
        success {
            slackSend(channel: SLACK_CHANNEL, color: '#36a64f', message: "SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})")
            mail to: 'dev-team@taskspace.com',
                 subject: "SUCCESSFUL Jenkins Build: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                 body: "The build completed successfully. Details: ${env.BUILD_URL}"
        }
        failure {
            slackSend(channel: SLACK_CHANNEL, color: '#ff0000', message: "FAILED: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})")
            mail to: 'dev-team@taskspace.com',
                 subject: "FAILED Jenkins Build: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                 body: "The build failed. Please review console output: ${env.BUILD_URL}"
            
            // Rollback deployment if deployment failed
            script {
                try {
                    withKubeConfig([credentialsId: KUBERNETES_CREDENTIALS_ID]) {
                        echo "Deployment failed! Rolling back to last stable version..."
                        sh "kubectl rollout undo deployment/task-manager-backend -n task-manager"
                        sh "kubectl rollout undo deployment/task-manager-frontend -n task-manager"
                    }
                } catch(Exception e) {
                    echo "Rollback failed or was not required: ${e.getMessage()}"
                }
            }
        }
    }
}
